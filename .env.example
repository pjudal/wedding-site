# Copy to .env.local for local testing against the real Google Sheet,
# and add the same two values in Vercel > Project > Settings > Environment Variables.
# Leave both unset locally to use data/guests.local.json instead (run `npm run seed`).
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Guest photo sharing (/share, /live, /photos/admin). Leave all of these unset locally:
# photos then go to data/photos and the keys are "dev" (guests) and "dev-admin" (you).
# In Vercel, set all six. PHOTO_KEY goes inside the QR code; PHOTO_ADMIN_KEY is only for PJ and Jedah.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PHOTO_KEY=
PHOTO_ADMIN_KEY=

# Shared key for the private online album draft in /album-admin.
# Set the same value in Vercel before using the draft across devices.
ALBUM_DRAFT_KEY=
